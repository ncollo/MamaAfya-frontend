{
  "version": "0.1",
  "name": "main.flow.json",
  "startNode": "entry",
  "catchAll": {
    "onReceive": [],
    "next": [
      { "condition": "true", "node": "fallback" }
    ]
  },
  "nodes": [
    {
      "name": "entry",
      "onEnter": [
        { "type": "say", "text": "Hi {{user.name | 'there'}}, I'm the MamaAfya assistant. How can I support you today?" }
      ],
      "onReceive": [],
      "next": [
        { "condition": "true", "node": "main_menu" }
      ]
    },
    {
      "name": "main_menu",
      "onEnter": [
        {
          "type": "say",
          "text": "Please choose an option:",
          "quickReplies": [
            { "label": "1. Report a symptom", "value": "symptom" },
            { "label": "2. Check my appointments / reminders", "value": "appointments" },
            { "label": "3. Nutrition & wellbeing tips", "value": "nutrition" },
            { "label": "4. EMERGENCY - I need help now", "value": "emergency" },
            { "label": "5. Talk to my CHW", "value": "chw" }
          ]
        }
      ],
      "onReceive": [
        { "type": "captureInput", "into": "temp.menuChoice" }
      ],
      "next": [
        { "condition": "temp.menuChoice === 'symptom'", "node": "symptom_triage.flow.json::start" },
        { "condition": "temp.menuChoice === 'appointments'", "node": "appointments.flow.json::start" },
        { "condition": "temp.menuChoice === 'nutrition'", "node": "nutrition.flow.json::start" },
        { "condition": "temp.menuChoice === 'emergency'", "node": "emergency.flow.json::start" },
        { "condition": "temp.menuChoice === 'chw'", "node": "connect_chw" },
        { "condition": "true", "node": "fallback" }
      ]
    },
    {
      "name": "connect_chw",
      "onEnter": [
        { "type": "action", "name": "notifyCHW", "args": { "reason": "mother_requested_chat" } },
        { "type": "say", "text": "I've notified your Community Health Worker. They'll reach out to you shortly. Is there anything else I can help with?" }
      ],
      "next": [
        { "condition": "true", "node": "main_menu" }
      ]
    },
    {
      "name": "fallback",
      "onEnter": [
        { "type": "say", "text": "Sorry, I didn't quite get that. You can say 'menu' anytime to see your options again." }
      ],
      "next": [
        { "condition": "true", "node": "main_menu" }
      ]
    }
  ]
}
